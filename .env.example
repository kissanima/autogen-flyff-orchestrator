DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://www.aibh.cc/v1
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4.1-flash

# Path to the repository the agents are allowed to work on.
FLYFF_PROJECT_ROOT=D:/Flyff source code

# Unattended-run limits. Requests and wall clock are the real limits; rounds are
# a runaway-loop guard and are off by default (0 = unlimited).
MAX_REQUESTS=4800
MAX_HOURS=8
MAX_ROUNDS=0
HISTORY_BUFFER=16
SHELL_TIMEOUT=600

# MCP: which servers, and whether both agents get all of them.
MCP_SERVERS=rea,unity
MCP_ROUTING=shared
MCP_TIMEOUT=60
